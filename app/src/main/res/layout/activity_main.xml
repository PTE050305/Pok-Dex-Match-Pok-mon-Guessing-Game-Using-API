<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/screenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="18dp"
        android:paddingEnd="34dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_stat_chip"
            android:text="@string/student_name"
            android:textColor="#1F315A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSectionCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_stat_chip"
            android:text="@string/section_code"
            android:textColor="#1F315A"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_stat_chip"
                android:text="Round: 1/5"
                android:textColor="#234074"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_stat_chip"
                android:text="Score: 0"
                android:textColor="#234074"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_game_card"
            android:elevation="10dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/headerPanel"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_header_panel"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="165dp"
                    android:layout_height="165dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_soft_orb" />

                <ImageView
                    android:id="@+id/ivPokemon"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/pokemon_image"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher"
                    android:translationY="20dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPokemonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="18dp"
                android:text="Pokemon"
                android:textColor="#1B2A4C"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPokemonNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="18dp"
                android:text="#000"
                android:textColor="#6A789B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutTypeBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTypeBadge1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Type"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTypeBadge2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Type"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="18dp"
                android:text="@string/result_placeholder"
                android:textColor="#35558E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAnswer1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_answer_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Choice 1"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAnswer2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_answer_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Choice 2"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAnswer3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_answer_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Choice 3"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAnswer4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_answer_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Choice 4"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNextPokemon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_next_button"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/next_pokemon"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/gameCompleteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_game_card"
            android:elevation="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/challenge_complete"
                android:textColor="#1C325C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalScoreOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/final_score_format"
                android:textColor="#35558E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartAnotherGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_next_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/start_another_game"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>